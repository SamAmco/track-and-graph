"1" = "ကြော်ငြာမရှိပါ။ ကိုယ်ရေးကိုယ်တာအချက်အလက် အပြည့်အဝလုံခြုံပါသည်။";
"2" = "စိတ်ကြိုက်ပြင်ဆင်နိုင်သော ဒေတာမြင်ကွင်းများ";
"3" = "ဒေတာကို လျင်မြန်စွာ မှတ်တမ်းတင်ရန် ဒီဇိုင်းထုတ်ထားသည်";
"4" = "အမှောင်အပြင်အဆင် အပြည့်အဝထောက်ပံ့မှု";
"5" = "ဂရပ်အမျိုးအစား ၇ မျိုးနှင့်အထက်";
"6" = "အဖွဲ့အစည်းကို စိတ်ကြိုက်အပြည့်အဝပြင်ဆင်နိုင်သည်";
"7" = "အသင့်ပါ သတိပေးချက်များ";
"8" = "မြင်ကွင်းအခြေပြု လော့ဂျစ်နှင့် Lua စကရစ်ပ်ရေးသားခြင်း";
